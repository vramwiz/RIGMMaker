function EffectDefault(const Name: string): Double;
begin
  if Name='Dly: Use' then Exit(0);
  if Name='Dly: Time(ms)' then Exit(250.0);
  if Name='Dly: Dry' then Exit(1.0);
  if Name='Dly: Wet' then Exit(0.0);
  if Name='Dly: Feedback' then Exit(0.0);
  if Name='Dly: Stereo Mode' then Exit(0);
  if Name='EQ: Use' then Exit(0);
  if Name='EQ: LowCut(Hz)' then Exit(300.0);
  if Name='EQ: HighCut(Hz)' then Exit(3400.0);
  if Name='EQ: Mix' then Exit(1.0);
  if Name='EQ: Mode' then Exit(2);
  if Name='Comp: Use' then Exit(0);
  if Name='Comp: Threshold(dB)' then Exit(-18.0);
  if Name='Comp: Ratio' then Exit(4.0);
  if Name='Comp: Attack(ms)' then Exit(10.0);
  if Name='Comp: Release(ms)' then Exit(120.0);
  if Name='Comp: Makeup(dB)' then Exit(0.0);
  if Name='Comp: Mix' then Exit(1.0);
  if Name='Drive: Use' then Exit(0);
  if Name='Drive: Drive(dB)' then Exit(9.0);
  if Name='Drive: Body' then Exit(0.45);
  if Name='Drive: Level(dB)' then Exit(-6.0);
  if Name='Drive: Mix' then Exit(0.6);
  if Name='Dist: Use' then Exit(0);
  if Name='Dist: Drive(dB)' then Exit(6.0);
  if Name='Dist: Tone' then Exit(1.0);
  if Name='Dist: Level(dB)' then Exit(-6.0);
  if Name='Dist: Mix' then Exit(1.0);
  if Name='Dist: Mode' then Exit(0);
  if Name='Noise: Use' then Exit(0);
  if Name='Noise: Level(dB)' then Exit(-36.0);
  if Name='Noise: Mix' then Exit(1.0);
  if Name='Noise: Mode' then Exit(0);
  if Name='Crush: Use' then Exit(0);
  if Name='Crush: BitDepth' then Exit(8.0);
  if Name='Crush: SampleHold' then Exit(4.0);
  if Name='Crush: Mix' then Exit(1.0);
  if Name='Trem: Use' then Exit(0);
  if Name='Trem: Rate(Hz)' then Exit(8.0);
  if Name='Trem: Depth' then Exit(0.35);
  if Name='Trem: Mix' then Exit(1.0);
  if Name='Wob: Use' then Exit(0);
  if Name='Wob: Delay(ms)' then Exit(24.0);
  if Name='Wob: Depth(ms)' then Exit(12.0);
  if Name='Wob: Rate(Hz)' then Exit(1.2);
  if Name='Wob: Mix' then Exit(0.65);
  if Name='Pitch: Use' then Exit(0);
  if Name='Pitch: Semitone' then Exit(0.0);
  if Name='Pitch: Window(ms)' then Exit(60.0);
  if Name='Pitch: Formant' then Exit(0.0);
  if Name='Pitch: Amount' then Exit(0.7);
  if Name='Pitch: Step(semi)' then Exit(5.0);
  if Name='Pitch: Rate(Hz)' then Exit(4.0);
  if Name='Pitch: Mix' then Exit(1.0);
  if Name='Pitch: Mode' then Exit(0);
  if Name='Ring: Use' then Exit(0);
  if Name='Ring: Frequency(Hz)' then Exit(45.0);
  if Name='Ring: Depth' then Exit(0.7);
  if Name='Ring: Mix' then Exit(0.7);
  if Name='Muffle: Use' then Exit(0);
  if Name='Muffle: Cutoff(Hz)' then Exit(1200.0);
  if Name='Muffle: Amount' then Exit(0.8);
  if Name='Muffle: Mix' then Exit(1.0);
  if Name='Breath: Use' then Exit(0);
  if Name='Breath: Level(dB)' then Exit(-18.0);
  if Name='Breath: Tone' then Exit(0.65);
  if Name='Breath: Mix' then Exit(0.5);
  if Name='AGain: Use' then Exit(0);
  if Name='AGain: Target(dB)' then Exit(-12.0);
  if Name='AGain: Speed(ms)' then Exit(400.0);
  if Name='AGain: MaxGain(dB)' then Exit(12.0);
  if Name='AGain: Mix' then Exit(1.0);
  if Name='Gate: Use' then Exit(0);
  if Name='Gate: Threshold(dB)' then Exit(-45.0);
  if Name='Gate: Attack(ms)' then Exit(5.0);
  if Name='Gate: Release(ms)' then Exit(120.0);
  if Name='Gate: Floor(dB)' then Exit(-60.0);
  if Name='Ghost: Use' then Exit(0);
  if Name='Ghost: Size(ms)' then Exit(420.0);
  if Name='Ghost: Feedback' then Exit(0.45);
  if Name='Ghost: Wet' then Exit(0.35);
  if Name='Ghost: Mix' then Exit(1.0);
  if Name='Cho: Use' then Exit(0);
  if Name='Cho: Delay(ms)' then Exit(15.0);
  if Name='Cho: Depth(ms)' then Exit(5.0);
  if Name='Cho: Rate(Hz)' then Exit(0.5);
