  if Name='Rev: Use' then Exit(0);
  if Name='Rev: RoomSize' then Exit(0.5);
  if Name='Rev: Damping' then Exit(0.4);
  if Name='Rev: Dry' then Exit(1.0);
  if Name='Rev: Wet' then Exit(0.3);
  if Name='Rev: Type' then Exit(0);
  if Name='Out: Use' then Exit(0);
  if Name='Out: Gain(dB)' then Exit(0.0);
  if Name='Lim: Use' then Exit(0);
  if Name='Lim: Ceiling(dB)' then Exit(-1.0);
  if Name='Lim: Release(ms)' then Exit(50.0);
  if Name='Lim: Mix' then Exit(1.0);
  raise Exception.Create('Unknown audio effect parameter: '+Name);
end;
