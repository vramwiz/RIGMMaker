<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{A130AEB6-085F-489F-8E9A-C93E93637B11}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>DotsCodexProbe.dpr</MainSource>
    <Base>true</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <TargetedPlatforms>2</TargetedPlatforms>
    <DCC_Namespace>System;Winapi;Vcl</DCC_Namespace>
    <DCC_UnitSearchPath>$(MSBuildProjectDirectory)</DCC_UnitSearchPath>
    <DCC_ExeOutput>$(MSBuildProjectDirectory)\..\..\..\Win64\DotsCodexProbe\$(Config)</DCC_ExeOutput>
    <DCC_DcuOutput>$(DCC_ExeOutput)\dcu</DCC_DcuOutput>
    <DCC_UsePackage></DCC_UsePackage>
    <DCC_DPIAwareness>PerMonitorV2</DCC_DPIAwareness>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Define>DEBUG</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_OverflowChecking>true</DCC_OverflowChecking>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Define>RELEASE</DCC_Define>
    <DCC_Optimize>true</DCC_Optimize>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <DCCReference Include="DotsProbeForm.pas" />
    <DCCReference Include="DotsCodexTransport.pas" />
    <DCCReference Include="DotsProbePipe.pas" />
    <BuildConfiguration Include="Base"><Key>Base</Key></BuildConfiguration>
    <BuildConfiguration Include="Debug"><Key>Debug</Key><CfgParent>Base</CfgParent></BuildConfiguration>
    <BuildConfiguration Include="Release"><Key>Release</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <Target Name="CreateProbeDcuDirectory" BeforeTargets="_PasCoreCompile">
    <MakeDir Directories="$(DCC_DcuOutput)" />
  </Target>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
