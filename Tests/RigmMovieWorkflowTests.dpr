begin
  Application.Initialize; TStyleManager.TrySetStyle('Windows Modern Dark'); Checks := TJSONArray.Create;
  for var I := 1 to ParamCount do begin
    if ParamStr(I).StartsWith('--fixture-dir=') then FixtureDirectory := ParamStr(I).Substring(14);
    if ParamStr(I).StartsWith('--ffmpeg=') then FFmpegExe := ParamStr(I).Substring(9);
  end;
  Root := TPath.Combine(ExtractFilePath(ParamStr(0)),'MovieWorkflow\'+FormatDateTime('yyyymmdd-hhnnss-zzz',Now)); ForceDirectories(Root);
  try
    try Tests; var O := TJSONObject.Create;
      try AddB(O,'success',True); AddN(O,'passed',Checks.Count); O.AddPair('directory',Root); O.AddPair('audioSource','deterministic test tone HTTP fixture, not VOICEVOX speech'); O.AddPair('checks',Checks.Clone as TJSONArray);
        TFile.WriteAllText(TPath.Combine(ExtractFilePath(ParamStr(0)),'movie-workflow-results.json'),O.ToJSON,TEncoding.UTF8);
      finally O.Free; end;
    except on E: Exception do begin
      var O := TJSONObject.Create;
      try AddB(O,'success',False); AddN(O,'partialPassed',Checks.Count); O.AddPair('error',E.Message); O.AddPair('directory',Root); O.AddPair('checks',Checks.Clone as TJSONArray);
        TFile.WriteAllText(TPath.Combine(ExtractFilePath(ParamStr(0)),'movie-workflow-results.json'),O.ToJSON,TEncoding.UTF8);
      finally O.Free; end;
      Writeln(E.ClassName+': '+E.Message); ExitCode := 1;
    end; end;
  finally Checks.Free; end;
end.
