  Vcl.Graphics, Vcl.ExtCtrls, Vcl.Imaging.pngimage, Vcl.Themes, Vcl.Styles,
  RigmEditorForm, RigmMovieForm, RigmMovieTimeline, RigmAppSettings, RigmMovieModel, RigmMovieAudio, RigmModel,
  RigmJson, RigmStorage, RigmPipeTestClient, ArtDocument, RigmNativeSaveDialog;
var Host: TRigmEditorForm; PipeName,Root,FixtureDirectory,FFmpegExe: string; Checks: TJSONArray;
procedure Check(Value: Boolean; const Name: string);
begin if not Value then raise Exception.Create('FAIL '+Name); Checks.Add(Name); Writeln('PASS: '+Name); end;
function Find(Parent: TWinControl; const Name: string): TControl;
begin Result := nil; for var I := 0 to Parent.ControlCount-1 do begin var C := Parent.Controls[I]; if C.Name=Name then Exit(C); if C is TWinControl then begin Result := Find(TWinControl(C),Name); if Result<>nil then Exit; end; end; end;
function Call(const Command: string; const Json: string='{}'; Mutating: Boolean=False): TJSONObject;
var Args,Reply: TJSONObject;
begin
  Args := ParseObject(Json);
  if Mutating then begin Args.AddPair('projectId',Host.Editor.Movie.Project.Id); AddN(Args,'revision',Host.Editor.Movie.Project.Revision); end;
  Reply := PipeCall(PipeName,'movie-'+Command,Args);
  try if not JB(Reply,'ok') then raise Exception.Create(Reply.ToJSON); Result := JO(Reply,'data').Clone as TJSONObject; finally Reply.Free; end;
end;
procedure Run(const Command: string; const Json: string='{}'; Mutating: Boolean=False);
begin var O := Call(Command,Json,Mutating); O.Free; end;
function Job: TJSONObject;
var Deadline: UInt64;
begin
  Deadline := GetTickCount64+20000;
  repeat
    Application.ProcessMessages; Host.Editor.PollMovie;
    Result := Call('job-status');
    if JB(Result,'done') then begin Host.Editor.PollMovie; if not Host.Editor.Movie.Busy then Exit; end;
    Result.Free;
    Sleep(5);
  until GetTickCount64>Deadline;
  raise Exception.Create('Movie job timeout');
end;
function Diagnostic: TJSONObject;
var Deadline: UInt64;
begin
  Deadline := GetTickCount64+15000;
  repeat
    Application.ProcessMessages; Host.Editor.PollMovie;
    Result := Call('preparation');
    if JB(Result,'diagnosticsCurrent') and not JB(Result,'diagnosticsBusy') then Exit;
    Result.Free; Sleep(5);
  until GetTickCount64>Deadline;
  raise Exception.Create('Current diagnostic timeout');
end;
procedure Capture(Form: TForm; const Name: string);
var Bitmap: Vcl.Graphics.TBitmap; Image: TPngImage;
begin
  Form.Repaint; Application.ProcessMessages; Bitmap := Vcl.Graphics.TBitmap.Create; Image := TPngImage.Create;
  try Bitmap.SetSize(Form.ClientWidth,Form.ClientHeight); Form.PaintTo(Bitmap.Canvas,0,0); Image.Assign(Bitmap); Image.SaveToFile(TPath.Combine(Root,Name+'.png'));
  finally Image.Free; Bitmap.Free; end;
end;
