    "imagePath": "",
    "sourceCues": [
      {
        "cueId": "{00512DCC-489C-4657-B91F-71E7EA2FB8A5}",
        "sourceText": "必要なものを調べて、道具をそろえて、使い方も確認する。"
      },
      {
        "cueId": "{713BB016-F033-478C-B36B-9C4FF291BE86}",
        "sourceText": "ここまでは、ものすごく順調なんです。"
      }
    ],
    "cueCount": 2,
    "hasMoreCues": false
  },
  {
