    "sourceCues": [
      {
        "cueId": "{23127194-B0E0-4249-B32B-80D8D2A832D2}",
        "sourceText": "ところが、いざ始めようとすると、"
      },
      {
        "cueId": "{C65D75B7-9556-4803-9CC9-14F957818B8B}",
        "sourceText": "「今日は時間がないから、明日からにしよう」"
      },
      {
        "cueId": "{D37A9F92-98EF-443A-A475-D909CF1DBAD9}",
        "sourceText": "なんて考えてしまう。"
      }
    ],
    "cueCount": 3,
    "hasMoreCues": false
  },
