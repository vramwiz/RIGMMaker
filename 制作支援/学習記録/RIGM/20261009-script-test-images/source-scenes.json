    "sourceCues": [
      {
        "cueId": "{CB6D7FE9-DA09-4E4C-B9B5-990FC47BA9E9}",
        "sourceText": "こんにちは。今日は、最近ちょっと気になっていることについて話してみます。"
      },
      {
        "cueId": "{1A61B475-68C5-4FD5-893E-8B2D4D4AA45C}",
        "sourceText": "皆さんは、何か新しいことを始めようと思ったのに、準備だけで満足してしまったことはありませんか？"
      },
      {
        "cueId": "{314FC87E-67B2-4DA5-B929-5CA233F06EF5}",
        "sourceText": "私は結構あります。"
      }
    ],
    "cueCount": 3,
    "hasMoreCues": false
  },
