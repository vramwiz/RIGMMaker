      "sourceCues": [
        {
          "cueId": "{389D1F0A-0119-4CF8-8D63-D667991FB116}",
          "sourceText": "東北きりたんです"
        },
        {
          "cueId": "{6FA58262-E981-4A3D-B2C6-39908C0F0537}",
          "sourceText": "今回もニコニコ漫画から"
        },
        {
          "cueId": "{E98D7DCD-4841-4B56-9B67-2A36CD74A16B}",
          "sourceText": "無料で最新話まで読める作品を紹介します"
        },
        {
          "cueId": "{2309E52D-1151-4D96-9926-CBE7EEAB30F9}",
          "sourceText": "今回は事前に確認したので大丈夫だと思います"
        },
        {
          "cueId": "{9D5157D6-EB58-4A1F-8B58-B78533734FBA}",
          "sourceText": "今回紹介する作品は"
        }
      ],
      "cueCount": 5,
      "hasMoreCues": false
    },
    {
