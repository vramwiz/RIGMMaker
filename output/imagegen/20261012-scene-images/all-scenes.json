      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{BAD54216-9F51-4A8B-A1ED-F4D6E81E4BD8}",
          "sourceText": "東北きりたんです"
        },
        {
          "cueId": "{19AB773D-1564-42C9-A501-4A10651BAFD4}",
          "sourceText": "今回もニコニコ漫画から"
        },
        {
          "cueId": "{C1009FF4-C044-48C8-A84A-EDA361CF6B20}",
          "sourceText": "無料で最新話まで読める作品を紹介します"
        },
        {
          "cueId": "{3C78A2B1-BCE0-49BC-9E87-CB7B65589EAF}",
          "sourceText": "今回紹介する作品は"
        },
        {
          "cueId": "{3913C936-6A07-4EC1-9549-39BFD45A3EBD}",
          "sourceText": "異世界「嘘」ガイド"
        },
        {
          "cueId": "{4494C3E7-F217-4E75-99EC-D85435B17A04}",
          "sourceText": "という作品です"
        }
      ],
      "cueCount": 6,
      "hasMoreCues": false
    },
    {
      "id": "{9B46C80C-96D0-4A15-B278-57FE14AFD193}",
      "title": "body 1",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 1,
      "animation": {},
      "sceneNumber": 2,
      "start": 10.8346666666667,
      "duration": 11.0666666666667,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{E4EE3D4A-CA58-4477-A426-53FE8EE522A3}",
          "sourceText": "異世界ものってそれこそ腐るほどあるのですが"
        },
        {
          "cueId": "{6F240AE7-1CCE-453C-A3A2-7A7B95529EFC}",
          "sourceText": "この作品は設定が少し変わっているかもしれません"
        },
        {
          "cueId": "{BF0B795E-0593-4245-85E4-430C695DE88B}",
          "sourceText": "と言ってもきっとどこかにあるパターンなんでしょ？"
        },
        {
          "cueId": "{97152092-6FA0-4B13-9183-3B9D50EDCC83}",
          "sourceText": "それでは世界観を簡単に説明します"
        }
      ],
      "cueCount": 4,
      "hasMoreCues": false
    },
    {
      "id": "{BFC55C30-29A1-40A5-B9AF-3F2EA0458134}",
      "title": "シーン 4",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 4,
      "animation": {},
      "sceneNumber": 3,
      "start": 21.9013333333333,
      "duration": 7.86533333333333,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{6693E745-F8FF-41C5-8B90-6DEAF48D81F8}",
          "sourceText": "ある日突然、異世界に転移させられた青年"
        },
        {
          "cueId": "{8AA74A06-9DEF-46C0-8A54-286FD454EFEB}",
          "sourceText": "あーよくあるパターンと言われそうです"
        },
        {
          "cueId": "{F85FFC08-C853-4BB2-A170-92105C827E4A}",
          "sourceText": "ですが主人公はどっちかというとヒロインのほう"
        }
      ],
      "cueCount": 3,
      "hasMoreCues": false
    },
    {
      "id": "{01133690-F6C2-45CA-8809-850BBACD6433}",
      "title": "シーン 5",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 2,
      "animation": {},
      "sceneNumber": 4,
      "start": 29.7666666666667,
      "duration": 14.1426666666667,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{1E8E66EF-5F97-4688-B597-8FB5398B58FF}",
          "sourceText": "下人族の女の子のナナ"
        },
        {
          "cueId": "{B8C97B2D-7959-4631-A84C-E9F886D6EDEE}",
          "sourceText": "森に迷い込んだ主人公を助けたナナは"
        },
        {
          "cueId": "{900F91E4-05BA-4E90-8CE2-1394F2EC5035}",
          "sourceText": "異世界での様々な作法を教えるために"
        },
        {
          "cueId": "{60048B3E-0CAB-400C-B26F-CFDF67E58D35}",
          "sourceText": "青年と旅をしながら教えていく"
        },
        {
          "cueId": "{DA2C64E8-5CEB-4950-A552-3D7BB128CEE2}",
          "sourceText": "そんなお話です"
        },
        {
          "cueId": "{3B9AB615-7DD4-4301-AD9E-CA3F15156EF9}",
          "sourceText": "やっぱりよくある話でしたか？"
        },
        {
          "cueId": "{0510829B-EDF0-4DF6-87CF-5121FDF56EAB}",
          "sourceText": "ですがこれウソなんですよね"
        }
      ],
      "cueCount": 7,
      "hasMoreCues": false
    },
    {
      "id": "{8E988242-D20B-486D-A31E-DBEFF465CA5D}",
      "title": "シーン 6",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 4,
      "animation": {},
      "sceneNumber": 5,
      "start": 43.9093333333333,
      "duration": 6.63866666666666,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{6472F1FA-1036-41E8-AA6F-C202365AEAF9}",
          "sourceText": "ナナは単純に自分の弱い立場を"
        },
        {
          "cueId": "{E06BA9B7-A815-425D-A112-8C4116D4D2A3}",
          "sourceText": "転生してきた人間の力を借りれば"
        },
        {
          "cueId": "{D5A85242-2EB9-44FE-8FE0-DA3B2573C4B1}",
          "sourceText": "夢のような暮らしが出来るだろう"
        }
      ],
      "cueCount": 3,
      "hasMoreCues": false
    },
    {
      "id": "{AD8102DC-38D6-4AD9-A52A-306D10A339CA}",
      "title": "シーン 7",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 3,
      "animation": {},
      "sceneNumber": 6,
      "start": 50.548,
      "duration": 7.46,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{96A54D28-F9C0-45A0-8163-BAEF90CACCD9}",
          "sourceText": "そんな下心で青年につきまとっているだけなんですよね"
        },
        {
          "cueId": "{7BF8668B-FD1C-4E98-BD28-A284AC2344DB}",
          "sourceText": "ではどこまでがウソなのか？"
        },
        {
          "cueId": "{3B802D39-DAE7-4AAD-AB9D-51FF9E3BDD99}",
          "sourceText": "ここがこの作品の面白いところです"
        }
      ],
      "cueCount": 3,
      "hasMoreCues": false
    },
    {
      "id": "{0722CC9E-CA37-4CC6-8074-658AB3E91992}",
      "title": "シーン 8",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 2,
      "animation": {},
      "sceneNumber": 7,
      "start": 58.008,
      "duration": 3.832,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{94B65025-432A-4ED1-B62F-917324B0B3DC}",
          "sourceText": "青年から見た異世界は"
        },
        {
          "cueId": "{8694C75E-D8FF-4BA9-B748-EDBB02AFF036}",
          "sourceText": "ナナが説明をしますがそれはウソ"
        }
      ],
      "cueCount": 2,
      "hasMoreCues": false
    },
    {
      "id": "{2781DBF7-6D04-448E-98BB-9CF729D2F70B}",
      "title": "シーン 9",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 2,
      "animation": {},
      "sceneNumber": 8,
      "start": 61.84,
      "duration": 12.784,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{D75B1C1D-CBD5-4F1B-9290-89224F402B68}",
          "sourceText": "ナナは自分の都合のよいウソはつくための説明をしますが"
        },
        {
          "cueId": "{4A48CDAA-A703-43F9-B9F3-A41AD0CD88FB}",
          "sourceText": "そもそも異世界の常識が日本人にとっては非常識なので"
        },
        {
          "cueId": "{B3030889-72E4-410D-83DC-075ADDE1EF08}",
          "sourceText": "ウソなのか本当なのかがわからなくなります"
        },
        {
          "cueId": "{6B8025F5-3C82-4367-8488-F3D69633BD12}",
          "sourceText": "まあそんなむずかしいことを考えなくてもいいんですけどね"
        }
      ],
      "cueCount": 4,
      "hasMoreCues": false
    },
    {
      "id": "{36F66DF3-FEC8-4818-9D30-D5402DF9DFC8}",
      "title": "シーン 10",
      "image": "",
      "description": "",
      "imagePrompt": "",
      "padding": 0,
      "imageFeedback": "",
      "imageApproved": false,
      "imageApprovalKey": "",
      "imageEditEpoch": 1,
      "animation": {},
      "sceneNumber": 9,
      "start": 74.624,
      "duration": 5.112,
      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{12CAA4BA-C8DD-44E0-9BA4-017BABEAB518}",
          "sourceText": "ナナのガイドで異世界を面白おかしく旅をしていく"
        },
        {
          "cueId": "{4DC961C0-AFA2-4AF8-A8CE-23AC0C1D901D}",
          "sourceText": "気楽に読めるマンガになっています"
        }
      ],
      "cueCount": 2,
      "hasMoreCues": false
    },
    {
