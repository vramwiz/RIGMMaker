      "ready": false,
      "imagePath": "",
      "sourceCues": [
        {
          "cueId": "{F96D8C39-9CB0-4970-8302-47E208B75165}",
          "sourceText": "このマンガのおすすめポイントとしては"
        },
        {
          "cueId": "{EF908E86-8694-47D0-B91B-9ECF64397D75}",
          "sourceText": "ヒロインのナナがいま流行の"
        },
        {
          "cueId": "{4219B2DC-037D-486C-8848-456FF149DDB3}",
          "sourceText": "うすほそ体型であることです"
        },
        {
          "cueId": "{F120394C-F44B-4D30-9479-53C012601C77}",
          "sourceText": "おそらく日々の暮らしにも困っているタイプなのでしょう"
        },
        {
          "cueId": "{CBBEA94B-5F6C-44B0-A85A-1A540866539F}",
          "sourceText": "あばら骨が少し見えるぐらいのうすほそです"
        },
        {
          "cueId": "{C1381C32-073E-4D12-AB1E-C5217BB46DF9}",
          "sourceText": "なのでうすほそマニアな人は是非読むことをおすすめします"
        }
      ],
      "cueCount": 6,
      "hasMoreCues": false
    },
